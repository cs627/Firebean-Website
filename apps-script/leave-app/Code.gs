/* ============================================================
 *  提交申請
 * ============================================================ */

/**
 * 把一個請求轉成時間區間 [a, b)，用來偵測重疊。
 *   上午半日 09:00-13:00 → [00:00, 13:00)
 *   下午半日 14:00-18:00 → [13:00, 24:00)
 *   全日 / 多日        → [開始日 00:00, 結束日+1 00:00)
 * 這樣同一天上午半日 + 下午半日不會被當成重疊。
 */
function _spanOf(start, end, dur) {
  const d = String(dur || '');
  const a0 = new Date(start.getFullYear(), start.getMonth(), start.getDate()).getTime();
  if (d.indexOf('0900') >= 0) return { a: a0, b: a0 + 13 * 3600000 };
  if (d.indexOf('1400') >= 0) return { a: a0 + 13 * 3600000, b: a0 + 24 * 3600000 };
  const e0 = new Date(end.getFullYear(), end.getMonth(), end.getDate()).getTime();
  return { a: a0, b: e0 + 24 * 3600000 };
}

/**
 * 找出同一同事已有、而且時間重疊嘅請求。
 *   excludeId    — 略過某個 Request ID（例如自己）
 *   onlyApproved — true = 只查已批核嘅（批核時用）
 */
function _findOverlap(email, start, end, dur, excludeId, onlyApproved) {
  const me = String(email || '').toLowerCase().trim();
  if (!me || !start || !end) return null;
  const want = _spanOf(start, end, dur);
  const rows = _read(T.REQ).rows;
  for (let i = 0; i < rows.length; i++) {
    const x = rows[i];
    if (String(x[1] || '').toLowerCase().trim() !== me) continue;
    const st = String(x[11] || '').trim();
    if (onlyApproved) { if (st !== 'Approved') continue; }
    else { if (st !== 'Pending' && st !== 'Approved') continue; }
    if (excludeId && String(x[0] || '').trim() === String(excludeId).trim()) continue;
    const s2 = _date(x[4]), e2 = _date(x[5]);
    if (!s2 || !e2) continue;
    const has = _spanOf(s2, e2, x[6]);
    if (want.a < has.b && has.a < want.b) {
      return { id: String(x[0] || ''), status: st, type: String(x[3] || ''),
               start: _iso(s2), end: _iso(e2), dur: String(x[6] || '') };
    }
  }
  return null;
}

function submitLeave(payload, who) {
  _WARN.length = 0;
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return { ok: false, error: 'The system is busy. Please try again in a moment.' };
  try {
    const sess = getSession(who);
    if (!sess.ok) return { ok: false, error: 'You are not on the staff list.' };

    const type  = String(payload.leaveType || '');
    const dur   = String(payload.duration || 'Full Day');
    const start = _date(payload.startDate);
    const end   = _date(payload.endDate);
    const reason = String(payload.reason || '').trim();
    const otDate = _date(payload.otDate);
    const eventName = String(payload.eventName || '').trim();

    if (LEAVE_TYPES.indexOf(type) < 0)            return { ok: false, error: 'Invalid leave type.' };
    if (DURATIONS.indexOf(dur) < 0)               return { ok: false, error: 'Invalid duration option.' };
    if (!start || !end)                           return { ok: false, error: 'Please pick both a start and an end date.' };
    if (end < start)                              return { ok: false, error: 'The end date cannot be before the start date.' };
    if (dur.indexOf('Half Day') >= 0 && _iso(start) !== _iso(end))
      return { ok: false, error: 'A half day must start and end on the same date.' };
    if (type === 'Compensation Leave' && !otDate)
      return { ok: false, error: 'Compensation leave requires the OT date.' };

    const days = _computeDays(start, end, dur);
    if (days <= 0) return { ok: false, error: 'No working days in that range (all weekends or public holidays).' };

    // 重複防御：同一段時間已有待批或已批核嘅請求 → 拒絕
    const clash = _findOverlap(sess.email, start, end, dur, '', false);
    if (clash) {
      return { ok: false, error:
        'You already have a ' + clash.status.toLowerCase() + ' ' + clash.type + ' request for ' +
        clash.start + (clash.start !== clash.end ? (' \u2192 ' + clash.end) : '') +
        ' (' + clash.dur + ', ref ' + clash.id + '). ' +
        'Cancel or change that one before submitting the same dates again.' };
    }

    // 年假：檢查可用餘額（包含待批）
    if (type === 'Annual Leave') {
      const b = _balanceFor(sess.email, _today());
      if (days > b.available + 0.001) {
        const carryTxt = b.carryIn ? ', carry-over from last year ' + b.carryIn : '';
        const pendTxt  = b.pending ? ', pending ' + b.pending : '';
        if (b.available <= 0) {
          return { ok: false, error:
            '\u26a0\ufe0f Your annual leave quota is used up. ' +
            'Entitlement ' + b.entitlement + ' days/year, accrued ' + b.accrued + carryTxt +
            ', used ' + b.used + pendTxt + ', remaining ' + b.available + ' days. ' +
            'You cannot apply for more annual leave. ' +
            'You may still apply for Compensation Leave or Sick Leave.' };
        }
        return { ok: false, error:
          '\u26a0\ufe0f Not enough annual leave left. Accrued ' + b.accrued + carryTxt +
          ', used ' + b.used + pendTxt + ', remaining ' + b.available +
          ' days \u2014 but you asked for ' + days + ' days.' };
      }
    }

    const row = new Array(REQ_COLS.length).fill('');
    row[0]  = _id();
    row[1]  = sess.email;
    row[2]  = sess.name;
    row[3]  = type;
    row[4]  = start;
    row[5]  = end;
    row[6]  = dur;
    row[7]  = String(payload.sickNote || '');
    row[8]  = reason;
    row[9]  = otDate ? otDate : '';
    row[10] = eventName;
    row[11] = 'Pending';
    row[12] = '';
    row[13] = days;
    row[14] = '';

    const sh = _sheet(T.REQ);
    const lastRow = Math.max(sh.getLastRow(), 1);
    sh.getRange(lastRow + 1, 1, 1, REQ_COLS.length).setValues([row]);

    // 通知：管理層 + 申請人
    _emailNewRequest(sess, { type: type, dur: dur, start: start, end: end,
                             days: days, reason: reason, otDate: otDate, eventName: eventName });

    return { ok: true, days: days, warnings: _WARN.slice(),
               message: 'Submitted — waiting for Dickson to approve.' + _warnText() };
  } catch (err) {
    return { ok: false, error: 'Submission failed: ' + err.message };
  } finally {
    lock.releaseLock();
  }
}

/* ============================================================
 *  管理層批核
 * ============================================================ */

function decideLeave(requestId, decision, comment, who) {
  _WARN.length = 0;
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return { ok: false, error: 'The system is busy. Please try again in a moment.' };
  try {
    const sess = getSession(who);
    if (!sess.ok || !sess.isManager) return { ok: false, error: 'You do not have approval rights.' };
    if (['Approved', 'Rejected'].indexOf(decision) < 0) return { ok: false, error: 'Invalid decision.' };

    const sh = _sheet(T.REQ);
    const values = sh.getDataRange().getValues();
    let rowIdx = -1, rec = null;
    for (let i = 1; i < values.length; i++) {
      if (String(values[i][0]).trim() === String(requestId).trim()) { rowIdx = i + 1; rec = values[i]; break; }
    }
    if (rowIdx < 0) return { ok: false, error: 'Request not found (it may have been deleted).' };

    const current = String(rec[11] || '').trim();
    if (current !== 'Pending') return { ok: false, error: 'This request has already been processed (current status: ' + current + ').' };

    const email = String(rec[1]).toLowerCase();
    const name = String(rec[2]);
    const type = String(rec[3]);
    const start = _date(rec[4]);
    const end = _date(rec[5]);
    const dur = String(rec[6]);
    const days = _num(rec[13]);
    const otDate = _date(rec[9]);
    const eventName = String(rec[10] || '');
    const reason = String(rec[8] || '');

    // 寫入狀態
    sh.getRange(rowIdx, 12).setValue(decision);
    sh.getRange(rowIdx, 13).setValue(String(comment || ''));

    if (decision === 'Approved') {
      const dup = _findOverlap(email, start, end, dur, requestId, true);
      if (dup) {
        return { ok: false, error:
          'Cannot approve: another APPROVED request already covers ' +
          dup.start + (dup.start !== dup.end ? (' \u2192 ' + dup.end) : '') +
          ' (' + dup.type + ', ' + dup.dur + ', ref ' + dup.id + '). ' +
          'Reject or fix that one first \u2014 otherwise leave would be counted twice.' };
      }
    }

    let calId = '';
    if (decision === 'Approved') {
      try {
        calId = _createCalendarEvent(name, email, type, start, end, dur, days, otDate, eventName, reason, comment);
        if (calId) sh.getRange(rowIdx, 15).setValue(calId);
      } catch (e) {
        // 唔好因為 calendar 失敗而令批核失敗
        console.error('Calendar error: ' + e.message);
      }
    }

    _emailDecision({ email: email, name: name, type: type, start: start, end: end,
                     days: days, decision: decision, comment: comment, otDate: otDate, eventName: eventName });

    // 同步 Staff!Current Annual Leave
    try { _syncStaffBalance(); } catch (e) { console.error('sync error: ' + e.message); }

    return { ok: true, warnings: _WARN.slice(), message: (decision === 'Approved' ? 'Approved' : 'Rejected') + (calId ? ' — added to calendar' : '') + _warnText() };
  } catch (err) {
    return { ok: false, error: 'Processing failed: ' + err.message };
  } finally {
    lock.releaseLock();
  }
}

/** 手動同步（管理層畫面個「重新整理」掣用） */
/** 管理層：標記／取消「醫生紙已收」。value='RECEIVED' → 記今日日期；value='' → 清空（未收） */
function markCertificate(requestId, value, who) {
  const sess = getSession(who);
  if (!sess.ok || !sess.isManager) return { ok: false, error: 'No permission' };
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return { ok: false, error: 'The system is busy. Please try again in a moment.' };
  try {
    const sh = _sheet(T.REQ);
    const v = sh.getDataRange().getValues();
    const want = String(requestId || '');
    for (let i = 1; i < v.length; i++) {
      if (String(v[i][0]) === want) {
        let txt = String(value || '').trim();
        if (txt.toUpperCase() === 'RECEIVED') txt = 'Received ' + _iso(_today());
        sh.getRange(i + 1, 16).setValue(txt);
        return { ok: true, certificate: txt };
      }
    }
    return { ok: false, error: 'Request not found.' };
  } finally {
    lock.releaseLock();
  }
}

function syncBalances(who) {
  const sess = getSession(who);
  if (!sess.ok || !sess.isManager) return { ok: false, error: 'No permission' };
  return { ok: true, updated: _syncStaffBalance() };
}

/* ============================================================
 *  核心計算
 * ============================================================ */

function _today() {
  const n = new Date();
  return new Date(n.getFullYear(), n.getMonth(), n.getDate());
}

/** 假期年度起始日（額度週期；7 月制 = 7/1–6/30） */
function _leaveYearStart(today) {
  const m = (CFG.LEAVE_YEAR_START_MONTH || 1) - 1;
  const y = (today.getMonth() >= m) ? today.getFullYear() : today.getFullYear() - 1;
  return new Date(y, m, 1);
}

/** 累積窗起點（同「已用」統計窗一致） */
function _accrualWindowStart(today) {
  return (CFG.ACCRUAL_WINDOW === 'leave_year')
    ? _leaveYearStart(today)
    : new Date(today.getFullYear(), 0, 1);
}

/** 某日生效嘅年假額度（最後一條 eff <= dt 嘅紀錄） */
function _rateAt(hist, dt) {
  const v = hist.filter(x => x.eff <= dt);
  return v.length ? v[v.length - 1].ent : 0;
}

/** 某日生效嘅年假額度喺何時記錄（用來解釋）*/
function _rateEffAt(hist, dt) {
  const v = hist.filter(x => x.eff <= dt);
  return v.length ? v[v.length - 1].eff : null;
}

/** 完整月數（例如 4/22 → 10/19 = 5，唔夠 22 號唔計） */
function _monthsBetween(a, b) {
  let m = (b.getFullYear() - a.getFullYear()) * 12 + (b.getMonth() - a.getMonth());
  if (b.getDate() < a.getDate()) m -= 1;
  return Math.max(0, m);
}

/** 累積年假：支援年中升職／調整年假額
 *  模式 CFG.ACCRUAL_MODE：
 *    'monthly'  = 逐個「完整月」累積（預設）。窗口 = CFG.ACCRUAL_WINDOW；
 *                 每個月嘅速率 = 該月所屬「假期年度」開始時生效嘅額度 ÷ 12
 *                 （所以升職要等到下一個假期年度 7/1 才反映喺累積上）
 *    'upfront'  = 年頭一次過派足全年額度；年中入職者按比例
 *    'pro_rata' = 逐段按生效日累積（舊邏輯）
 */
function _accrual(email, today) {
  const h = _read(T.HIST);
  const hist = h.rows
    .filter(r => String(r[0]).toLowerCase() === email)
    .map(r => ({ eff: _date(r[1]), ent: _num(r[2]) }))
    .filter(x => x.eff)
    .sort((a, b) => a.eff - b.eff);

  if (!hist.length) return { ent: 0, acc: 0, segs: [] };

  const lyStart = _leaveYearStart(today);
  const curEnt = _rateAt(hist, today);
  const mode = CFG.ACCRUAL_MODE || 'monthly';

  // ── 全年派足 ──
  if (mode === 'upfront' && hist[0].eff <= lyStart) {
    return {
      ent: curEnt, acc: curEnt,
      segs: [{ from: _iso(lyStart), eff: _iso(hist[0].eff), ent: curEnt,
               months: 12, days: curEnt, upfront: true }],
      hist: hist.map(x => ({ eff: _iso(x.eff), ent: x.ent }))
    };
  }

  // ── 逐個完整月累積 ──
  if (mode === 'monthly') {
    const winStart = _accrualWindowStart(today);
    const n = _monthsBetween(winStart, today);   // 只有「完整月」計數
    // 每月速率 = 該月所屬假期年度開始時生效嘅額度；
    // 但若該假期年度開始時仲未有任何紀錄（首年入職／首年建檔），
    // 就改用該月 1 號當日生效嘅額度，避免白白漏計。
    // 入職月份之前嘅月份一律唔計。
    const hireM = new Date(hist[0].eff.getFullYear(), hist[0].eff.getMonth(), 1);
    const rateInfoForMonth = (mStart) => {
      if (mStart < hireM) return { r: 0, src: null };
      const lys = _leaveYearStart(mStart);
      const r = _rateAt(hist, lys);
      if (r > 0) return { r: r, src: _rateEffAt(hist, lys) };
      return { r: _rateAt(hist, mStart), src: _rateEffAt(hist, mStart) };
    };
    const rateForMonth = (mStart) => rateInfoForMonth(mStart).r;
    // 用同一個分段邏輯跑兩個長度：n 個月（至今）同 12 個月（全年）
    const runSegs = (count) => {
      const out = []; let total = 0, i = 0;
      while (i < count) {
        const mStart = new Date(winStart.getFullYear(), winStart.getMonth() + i, 1);
        const rate = rateForMonth(mStart);
        let j = i + 1;
        while (j < count) {
          const m2 = new Date(winStart.getFullYear(), winStart.getMonth() + j, 1);
          if (rateForMonth(m2) !== rate) break;
          j++;
        }
        const months = j - i;
        const days = months * rate / 12;
        total += days;
        const src = rateInfoForMonth(mStart).src;
        out.push({ from: _iso(mStart), ent: rate, months: months,
                   days: Math.round(days * 100) / 100,
                   rateFrom: src ? _iso(src) : '' });
        i = j;
      }
      return { segs: out, total: Math.round(total * 100) / 100 };
    };
    const ytd = runSegs(n), full = runSegs(12);
    // 最後一個完整月嘅月尾（例如 10/19 → 9/30）
    const lastFull = new Date(today.getFullYear(), today.getMonth(), 0);
    return {
      ent: curEnt,
      acc: ytd.total,
      accFullYear: full.total,
      segs: ytd.segs,
      segsFullYear: full.segs,
      windowStart: _iso(winStart),
      accruedTo: _iso(lastFull),
      monthsCounted: n,
      hist: hist.map(x => ({ eff: _iso(x.eff), ent: x.ent }))
    };
  }

  // ── 舊邏輯：逐段按生效日 ──
  let acc = 0;
  const segs = [];
  for (let i = 0; i < hist.length; i++) {
    const s = new Date(Math.max(hist[i].eff.getTime(), lyStart.getTime()));
    const nextEff = (i + 1 < hist.length) ? hist[i + 1].eff : new Date(2099, 0, 1);
    const e = new Date(Math.min(nextEff.getTime(), today.getTime()));
    if (s >= e) continue;
    const m = Math.min(_monthsBetween(s, e), 12);
    if (m <= 0) continue;
    const days = m * hist[i].ent / 12;
    acc += days;
    segs.push({ from: _iso(s), eff: _iso(hist[i].eff), ent: hist[i].ent,
                months: m, days: Math.round(days * 100) / 100 });
  }
  return {
    ent: curEnt,
    acc: Math.round(acc * 100) / 100,
    segs: segs,
    hist: hist.map(x => ({ eff: _iso(x.eff), ent: x.ent }))
  };
}

/** 把日數對齊到 0.5 日網格 */
function _roundHalf(n) {
  const g = CFG.ROUND_TO || 0.5;
  const x = Number(n) / g;
  const m = CFG.ROUND_MODE;
  // 1e-9 誤差保護：避免 11.5/0.5 之類嘅浮點雜訊被 ceil 推高一個單位
  const r = (m === 'floor') ? Math.floor(x + 1e-9)
          : (m === 'ceil')  ? Math.ceil(x - 1e-9)
          : Math.round(x);
  return Math.round(r * g * 100) / 100;
}

/** 某個完整年度嘅累積日數（用全年 12 個月計）*/
function _accruedForYear(email, y) {
  const a = _accrual(email, new Date(y, 11, 31));
  const v = (a.accFullYear != null) ? a.accFullYear : a.acc;
  return _roundHalf(Math.round(v * 100) / 100);
}

/** 某個年度內已批核嘅年假日數（去重）*/
function _usedInWindow(rows, email, from, to) {
  const map = _dayMapFrom(rows, email, from, 'Approved', 'Annual Leave', to);
  return _sumDayMap(map);
}

/** 帶入年假嘅最後有效日 = 新一年第 CARRY_MONTHS 個月嘅最後一日（預設 2 月尾）*/
function _carryExpiry(winStart) {
  return new Date(winStart.getFullYear(), CFG.CARRY_MONTHS, 0);
}

/**
 * 年假結數帶落下一年（正數有期限、負數無期限）。
 * 規則：每年結數若為負數（超用）→ 全數帶到下一年扣返；
 *       若為正數（用唔晒）→ 唔帶，年底歸零。
 * 回傳 { days, detail } —— days 一定 <= 0。
 */
function _carryIn(email, today) {
  const req  = _read(T.REQ);
  const hist = _read(T.HIST);
  const winStart = _accrualWindowStart(today);

  // 找最早有記錄嘅年份
  let earliest = null;
  const note = (d) => { if (d && (!earliest || d < earliest)) earliest = d; };
  req.rows.forEach(r => {
    if (String(r[1] || '').toLowerCase() !== email) return;
    if (String(r[3] || '') !== 'Annual Leave') return;
    note(_date(r[4]));
  });
  hist.rows.forEach(r => {
    if (String(r[0] || '').toLowerCase() !== email) return;
    note(_date(r[1]));
  });
  if (!earliest) return { days: 0, raw: 0, expired: false, expiry: '', detail: [] };
  // 系統起算年之後嘅年度已經係最新一年 → 完全冇結轉（2026 年全年都走呢條路）
  if (winStart.getFullYear() <= Number(String(CFG.SYSTEM_START || '1970-01-01').slice(0, 4))) {
    return { days: 0, raw: 0, expired: false, expiry: _carryExpiry(winStart), detail: [] };
  }

  let carry = 0;
  const detail = [];
  const lastY = winStart.getFullYear() - 1;
  const sysY  = Number(String(CFG.SYSTEM_START || '1970-01-01').slice(0, 4));
  // 唔可以由系統起算年之前開始結轉（2025 年及之前嘅年度唔計）
  const startY = Math.max(earliest.getFullYear(), sysY);
  for (let y = startY; y <= lastY; y++) {
    const from = new Date(y, 0, 1);
    const to   = new Date(y + 1, 0, 1);
    const acc  = _accruedForYear(email, y);
    const used = _usedInWindow(req.rows, email, from, to);
    // 上一年帶落嚟嘅正數喺當年 3 月 1 日已經失效，所以計「年結」時只計負數（超用）
    const validCarry = Math.min(0, carry);
    const closing = Math.round((validCarry + acc - used) * 100) / 100;
    detail.push({ year: y, accrued: acc, used: Math.round(used * 100) / 100,
                  carryIn: carry, closing: closing });
    carry = closing;   // 正負都帶落下一年（正數受 CARRY_MONTHS 期限限制）
  }
  const raw = Math.round(carry * 100) / 100;
  const expiry = _carryExpiry(winStart);
  const expired = raw > 0 && today.getTime() > expiry.getTime();
  return {
    days   : expired ? 0 : raw,   // 實際可用嘅帶入
    raw    : raw,                 // 上年結數（未過濾期限）
    expired: expired,             // true = 有正數但已過期
    expiry : _iso(expiry),        // 最後有效日（2 月最後一日）
    detail : detail
  };
}

/** 某員工餘額 */
/**
 * 將一個請求展開成「佔用格」。
 *   全日   → 每個工作日一個 'YYYY-MM-DD'
 *   上午半日 → 'YYYY-MM-DD#AM'
 *   下午半日 → 'YYYY-MM-DD#PM'
 */
function _slotKeys(start, end, dur) {
  if (!start || !end || end < start) return [];
  const d0 = String(dur || '');
  if (d0.indexOf('Half Day') >= 0) {
    return [_iso(start) + (d0.indexOf('1400') >= 0 ? '#PM' : '#AM')];
  }
  const hol = _holidaySet();
  const out = [];
  const d = new Date(start.getTime());
  while (d <= end) {
    const dow = d.getDay();
    if (dow !== 0 && dow !== 6 && !hol[_iso(d)]) out.push(_iso(d));
    d.setDate(d.getDate() + 1);
  }
  return out;
}

/** 從請求清單建立「每一天佔用了什麼」地圖 */
function _dayMapFrom(rows, email, sinceDate, statusWanted, leaveType, untilDate) {
  const map = {};
  (rows || []).forEach(function (r) {
    if (String(r[1] || '').toLowerCase() !== email) return;
    const st = _date(r[4]);
    if (!st || (sinceDate && st < sinceDate)) return;
    if (untilDate && st >= untilDate) return;
    if (leaveType && String(r[3] || '') !== leaveType) return;
    if (String(r[11] || '').trim() !== statusWanted) return;
    _slotKeys(st, _date(r[5]), r[6]).forEach(function (k) {
      const i = k.indexOf('#');
      const date = i < 0 ? k : k.slice(0, i);
      const tag  = i < 0 ? 'full' : (k.slice(i) === '#AM' ? 'am' : 'pm');
      map[date] = map[date] || { full: false, am: false, pm: false };
      map[date][tag] = true;
    });
  });
  return map;
}

/** 一個日子最多只計 1 日（上+下午半日 = 1，全日 = 1） */
function _usedOn(m) {
  if (!m) return 0;
  if (m.full) return 1;
  return (m.am ? 0.5 : 0) + (m.pm ? 0.5 : 0);
}

function _sumDayMap(map) {
  let n = 0;
  Object.keys(map).forEach(function (d) { n += _usedOn(map[d]); });
  return n;
}

function _balanceFor(email, today) {
  const req = _read(T.REQ);
  const lyStart = _accrualWindowStart(today);   // 同累積窗一致（預設 = 本年度 1/1）
  let otherUsed = 0, naiveUsed = 0;
  req.rows.forEach(r => {
    if (String(r[1] || '').toLowerCase() !== email) return;
    const st = _date(r[4]);
    if (!st || st < lyStart) return;
    const status = String(r[11] || '').trim();
    const lt = String(r[3] || '');
    if (lt === 'Annual Leave' && status === 'Approved') naiveUsed += _num(r[13]);
    else if (lt !== 'Annual Leave' && status === 'Approved') otherUsed += _num(r[13]);
  });

  /* 去重計算：同一日子無論審批幾次，只會計 1 次。
     每次都從請求清單重新建地圖，所以即使已經重複批核也唔會 double count。 */
  const aMap = _dayMapFrom(req.rows, email, lyStart, 'Approved', 'Annual Leave');
  const pMap = _dayMapFrom(req.rows, email, lyStart, 'Pending',  'Annual Leave');
  const used = _sumDayMap(aMap);

  // 待批只計「已批核尚未覆蓋」嘅部份
  let pending = 0;
  Object.keys(pMap).forEach(function (d) {
    const p = pMap[d], a = aMap[d];
    const onlyP = _usedOn(p);
    if (!a) { pending += onlyP; return; }
    const mine = _usedOn(a);
    const both = Math.min(1,
      (p.full || a.full) ? 1
      : (((p.am || a.am) ? 0.5 : 0) + ((p.pm || a.pm) ? 0.5 : 0)));
    pending += Math.max(0, both - mine);
  });

  // 被合併掉嘅重複日數（僅作顯示）
  const mergedDays = Math.round((naiveUsed - used) * 100) / 100;
  const a = _accrual(email, today);
  const accruedRaw = Math.round(a.acc * 100) / 100;
  const carry = _carryIn(email, today);   // 去年帶落嚟嘅結轉（正數有期限、負數無期限）

  /* 結轉池（CARRY FORWARD POOL）
     1–2 月內已批核嘅年假，必須先由去年結轉扣抵 —— 唔可以當成本年度累積嘅使用。
     舊寫法只將「未用嘅結轉」歸零，但同時照計 1–2 月嘅使用，
     結果令「2 月底前用咗結轉」嘅同事被少計（例：去年剩 14 日、1 月用咗 4 日 → 應該只扣 4 日，
     舊寫法卻由本年度累積扣足 8 日）。 */
  let carryCredit = 0;
  if (carry.raw > 0 && carry.expired) {
    const poolEnd = new Date(lyStart.getFullYear(), CFG.CARRY_MONTHS, 1);   // 3 月 1 日（不含）
    const poolUsed = _sumDayMap(_dayMapFrom(req.rows, email, lyStart, 'Approved', 'Annual Leave', poolEnd));
    carryCredit = Math.min(carry.raw, Math.round(poolUsed * 100) / 100);
  }
  const usedCharged = Math.max(0, Math.round((used - carryCredit) * 100) / 100);
  const accrued = _roundHalf(accruedRaw);
  return {
    entitlement: a.ent,
    accrued: accrued,
    accruedRaw: accruedRaw,
    used: Math.round(used * 100) / 100,
    pending: Math.round(pending * 100) / 100,
    otherUsed: Math.round(otherUsed * 100) / 100,
    mergedDays: mergedDays > 0 ? mergedDays : 0,
    carryCredit: carryCredit,
    carryIn: carry.days,
    carryRaw: carry.raw,
    carryExpired: !!carry.expired,
    carryExpiry: carry.expiry || '',
    carryDetail: carry.detail,
    usedCharged: usedCharged,
    available: Math.round((accrued + carry.days - usedCharged - pending) * 100) / 100,
    fullYear: Math.round((_roundHalf(a.accFullYear != null ? a.accFullYear : a.ent)
                          + carry.days - usedCharged - pending) * 100) / 100,
    accruedTo: a.accruedTo || '',
    windowStart: a.windowStart || '',
    accFullYearRaw: a.accFullYear != null ? a.accFullYear : a.ent,
    entHistory: a.hist || []
  };
}

/** 逐日計工作日（扣週六日 + 公眾假期） */
function _computeDays(start, end, duration) {
  if (String(duration || '').indexOf('Half Day') >= 0) return 0.5;
  if (!start || !end || end < start) return 0;
  const hol = _holidaySet();
  let n = 0;
  const d = new Date(start.getTime());
  while (d <= end) {
    const dow = d.getDay();
    if (dow !== 0 && dow !== 6 && !hol[_iso(d)]) n++;
    d.setDate(d.getDate() + 1);
  }
  return n;
}

var _HOL_CACHE = null;
function _holidaySet() {
  if (_HOL_CACHE) return _HOL_CACHE;
  const h = _read(T.HOL);
  const set = {};
  h.rows.forEach(r => { const d = _date(r[0]); if (d) set[_iso(d)] = true; });
  _HOL_CACHE = set;
  return set;
}

/* ============================================================
 *  Email / Calendar
 * ============================================================ */

/** '2026-09-30' → 'Sep 2026' */
function _monthLabel(iso) {
  const d = _date(iso);
  if (!d) return '';
  return ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()] +
         ' ' + d.getFullYear();
}

/**
 * ⭐ 自我測試 —— 喺 Apps Script 編輯器上方揀「testNotifications」→ Run
 *    會（1）真發一封測試 email、（2）真建一個日曆活動再即刻刪走。
