    const t = new Date();
    const ev = cal.createAllDayEvent('TEST - Firebean Leave App (\u81ea\u52d5\u522a\u9664) ' + stamp, t,
      { description: '\u81ea\u52d5\u6e2c\u8a66\uff0c45 \u79d2\u5f8c\u6703\u81ea\u52d5\u522a\u9664\u3002' });
    log.push('\u2705 Calendar OK \u2192 \u5beb\u5165\u65e5\u66c6\uff1a' + cal.getName());
    log.push('   \u8acb\u53bb Google Calendar \u53f3\u908a\u770b\u4e00\u773c\uff08\u4eca\u65e5\uff09\uff0c45 \u79d2\u5f8c\u81ea\u52d5\u522a\u9664\u3002');
    Utilities.sleep(45000);
    ev.deleteEvent();
    log.push('\u2705 \u6e2c\u8a66\u6d3b\u52d5\u5df2\u522a\u9664\uff0c\u65e5\u66c6\u5df2\u9084\u539f');
  } catch (e) {
    log.push('\u274c Calendar FAIL \u2192 ' + e.message);
  }

  log.push('');
  log.push('DRY_RUN = ' + CFG.DRY_RUN +
    (CFG.DRY_RUN ? '  \u26a0\ufe0f \u4ecd\u7136\u662f true\uff0c\u6b63\u5f0f\u4e0a\u7dda\u524d\u6539 false'
                 : '  \u2705 \u5df2\u958b\u653e\u771f\u767c\u9001'));
  log.push('CALENDAR_NAME = ' + CFG.CALENDAR_NAME);
  log.push('CALENDAR_GUESTS = ' + CFG.CALENDAR_GUESTS);
  Logger.log(log.join('\n'));
  return log.join('\n');
}

function _staffEmails() {
  return _read(T.STAFF).rows
    .map(r => String(r[0]).toLowerCase())
    .filter(e => e.indexOf('@') > 0);
}

function _calendar() {
  const want = String(CFG.CALENDAR_NAME || '').trim();
  if (!want || want.toLowerCase() === 'primary' || want.toLowerCase() === 'default') {
    return CalendarApp.getDefaultCalendar();
  }
  const hits = CalendarApp.getCalendarsByName(want);
  if (hits && hits.length) return hits[0];
  Logger.log('\u26a0\ufe0f \u627e\u5514\u5230\u65e5\u66c6 "' + want +
             '"\uff0c\u6539\u7528\u9810\u8a2d\u65e5\u66c6\u3002\u73fe\u6709\u65e5\u66c6\uff1a\n' +
             listCalendars().join('\n'));
  _warn('找唔到日曆「' + want + '」，已改用預設日曆写入');
  return CalendarApp.getDefaultCalendar();
}

/** 喺編輯器 Run 呢個 function 就會列出你所有日曆嘅正確名稱。 */
/**
 * 補寫日曆 —— 把「已批核但未有 Calendar Event ID」嘅舊紀錄補上 Firebean Team 日曆。
 *
 * 用法：
 *   1) 保持 DRY = true → Run → 看 Execution log（只列出會做啫，不會寫）
 *   2) 確認清單喺對 → 改 DRY = false → Run → 正式寫入並回寫 event ID 到 O 欄
 *
 * 重複安全：已有 event ID 嘅行會跳過；日曆上同日已有同事同類型活動也會跳過。
 */
function backfillCalendar() {
  const DRY = true;   // ⬅️ 先 true 預覽；確認後改 false 才真正寫入

  const sh = _sheet(T.REQ);
  const values = sh.getDataRange().getValues();
  const cal = _calendar();
  const log = [];
  let nAdd = 0, nSkip = 0, nFail = 0;
  const writes = [];

  log.push('日曆：' + cal.getName() + '   |   DRY = ' + DRY +
           '   |   CFG.DRY_RUN = ' + CFG.DRY_RUN);

  for (let i = 1; i < values.length; i++) {
    const r = values[i];
    const name = String(r[2] || '').trim();
    const type = String(r[3] || '').trim();
    const start = _date(r[4]);
    const end = _date(r[5]);
    const dur = String(r[6] || '');
    const days = _num(r[13]);
    const status = String(r[11] || '').trim();
    const reason = String(r[8] || '').trim();
    const comment = String(r[12] || '').trim();
    const otDate = _date(r[9]);
    const eventName = String(r[10] || '');
    const oldId = String(r[14] || '').trim();
    const email = String(r[1] || '').toLowerCase();

    if (status !== 'Approved') continue;
    if (!name || !start || !end) { nSkip++; log.push('SKIP  欄位空白   row ' + (i + 1)); continue; }
    if (oldId) { nSkip++; log.push('SKIP  已有 event ID   ' + name + ' · ' + type + ' · ' + _iso(start)); continue; }

    // 查重：日曆上同日已有「同事 + 同類型」活動就跳過
    let dupTitle = '';
    try {
      const from = new Date(start.getTime()); from.setDate(from.getDate() - 1); from.setHours(0, 0, 0, 0);
      const to = new Date(end.getTime()); to.setDate(to.getDate() + 2); to.setHours(0, 0, 0, 0);
      const hits = cal.getEvents(from, to).filter(function (e) {
        return e.getTitle().indexOf(name + ' - ' + type) >= 0;
      });
      if (hits.length) dupTitle = hits[0].getTitle();
    } catch (e) {
      log.push('⚠️ 查重失敗 row ' + (i + 1) + '：' + e.message);
    }

    if (dupTitle) { nSkip++; log.push('SKIP  日曆已有   ' + dupTitle + '  @ ' + _iso(start)); continue; }

    const line = (DRY ? 'ADD   ' : '寫入  ') + name + ' - ' + type +
                 (String(dur).indexOf('Half Day') >= 0 ? ' (Half Day)' : ' (Full Day)') +
                 '   ' + _iso(start) + ' → ' + _iso(end) + '   (' + days + 'd)' +
                 (reason ? '   · ' + reason : '');
    log.push(line);

    if (!DRY) {
      try {
        const id = _createCalendarEvent(name, email, type, start, end, dur, days,
                                        otDate, eventName, reason, comment);
        if (id) { writes.push({ row: i + 1, id: id }); nAdd++; }
        else { nFail++; log.push('      ❌ 建不到（CFG.DRY_RUN = ' + CFG.DRY_RUN + '）'); }
      } catch (e) {
        nFail++; log.push('      ❌ ' + e.message);
      }
    } else {
      nAdd++;
    }
  }

  if (!DRY && writes.length) {
    writes.forEach(function (w) { sh.getRange(w.row, 15).setValue(w.id); });
    log.push('');
    log.push('已回寫 ' + writes.length + ' 個 event ID 到 O 欄。');
  }

  log.push('');
  log.push('—— 總結：' + (DRY ? '將會新增 ' : '已新增 ') + nAdd +
           ' · 跳過 ' + nSkip + ' · 失敗 ' + nFail + ' ——');
  if (DRY) log.push('（預覽模式，未寫入。確認後改 DRY = false 再 Run）');

  Logger.log(log.join('\n'));
  return log.join('\n');
}

/**
 * 同步年假額度歷史 —— 把 Staff!D 嘅新額度寫入 Entitlement_History。
 *
 * 何時用：你喺 Google Sheet 改完某人嘅 Annual Entitlement（D 欄）之後，Run 一次。
 *
 * 用法：DRY = true → Run → 看 log（只預覽）→ 改 DRY = false → Run → 真寫入
 *
 * ⬅️ EFFECTIVE_DATE 建議填該年度嘅 7 月 1 日。App 計法是「該假期年度（Jul 1 – Jun 30）開始日生效嘅額度」，
 *    所以一個 2026-06-01 嘅行，要到 2026-07-01 喺會開始影響計數；填中間日期會被跳過。
 */
function syncEntitlementHistory() {
  const DRY = true;                              // ⬅️ 先 true 預覽
  const EFFECTIVE_DATE = _iso(_today());         // ← 改成例如 '2026-07-01' 如果想指定生效日

  const sh = _sheet(T.STAFF);
  const sv = sh.getDataRange().getValues();
  const h = _read(T.HIST);
  const hv = h.rows;                              // 不含表頭
  const log = [];
  let nAdd = 0, nSame = 0;
  const appends = [];

  const ly = _leaveYearStart(_date(EFFECTIVE_DATE));
  if (_iso(ly) !== EFFECTIVE_DATE) {
    log.push('⚠️ EFFECTIVE_DATE = ' + EFFECTIVE_DATE +
             '，不是假期年度開始日。建議改成 ' + _iso(ly) +
             '，否則呢次調整會到下一個年度才生效。');
    log.push('');
  }

  // 每人嘅最新歷史紀錄
  const latest = {};
  hv.forEach(function (r) {
    const em = String(r[0] || '').toLowerCase().trim();
    const dt = _date(r[1]);
    const ent = _num(r[2]);
    if (!em || !dt) return;
    if (!latest[em] || dt >= latest[em].dt) latest[em] = { dt: dt, ent: ent };
  });

  log.push('EFFECTIVE_DATE = ' + EFFECTIVE_DATE + '   |   DRY = ' + DRY);
  log.push('');

  for (let i = 1; i < sv.length; i++) {
    const email = String(sv[i][0] || '').toLowerCase().trim();
    if (!email) continue;
    const name = String(sv[i][1] || '');
    const ent = _num(sv[i][3]);
    const cur = latest[email];

    if (!cur) {
      log.push('ADD   ' + name + ' (' + email + ')  — 完全沒歷史 → ' + ent + ' days');
      appends.push({ email: email, ent: ent }); nAdd++;
    } else if (Math.abs(cur.ent - ent) > 0.001) {
      log.push('ADD   ' + name + ' (' + email + ')  — ' + cur.ent + ' days (' + _iso(cur.dt) + ') → ' + ent + ' days');
      appends.push({ email: email, ent: ent }); nAdd++;
    } else {
      log.push('OK    ' + name + ' (' + email + ')  — ' + ent + ' days，已有紀錄');
      nSame++;
    }
  }

  if (!DRY && appends.length) {
    const startRow = 2 + hv.length;
    const rows = appends.map(function (a) {
      return [a.email, EFFECTIVE_DATE, a.ent, a.email + '|' + EFFECTIVE_DATE, '自動同步'];
    });
    _sheet(T.HIST).getRange(startRow, 1, rows.length, 5).setValues(rows);
    log.push('');
    log.push('已寫入 ' + rows.length + ' 行到 Entitlement_History（由第 ' + startRow + ' 行開始）');
  }

  log.push('');
  log.push('—— 總結：' + (DRY ? '將新增 ' : '已新增 ') + nAdd +
           ' 行 · 無變 ' + nSame + ' 人 ——');
  if (DRY) log.push('（預覽模式，未寫入。確認後改 DRY = false 再 Run）');

  Logger.log(log.join('\n'));
  return log.join('\n');
}

function listCalendars() {
  return CalendarApp.getAllCalendars().map(function (c) {
    return '  ' + c.getName() + '  \u2014 \u6211\u55ba\u9762\u53ef\u5beb\uff1a' +
           (c.isOwnedByMe() ? 'yes (owner)' : 'shared');
  });
}

function _createCalendarEvent(name, email, type, start, end, dur, days, otDate, eventName, reason, comment) {
  const cal = _calendar();
  const calName = cal.getName();
  if (CFG.DRY_RUN) {
    Logger.log('[DRY RUN] would create calendar event on "' + calName + '": ' + name + ' \u00b7 ' +
               type + ' \u00b7 ' + _iso(start) + ' \u2192 ' + _iso(end) + ' (' + days + 'd)');
    return '';
  }

  const half = String(dur).indexOf('Half Day') >= 0;
  const am = String(dur).indexOf('0900') >= 0;
  const clean = String(type).replace(/\s+Leave$/, '').trim();   // 'Annual Leave' → 'Annual'

  let title = name + ' - ' + type + (half ? ' (Half Day)' : ' (Full Day)');
  const why = String(reason || '').trim();
  if (why && why !== '.' && why !== '-') {
    title += ' \u00b7 ' + (why.length > 38 ? why.slice(0, 37) + '\u2026' : why);
  }

  const desc = [
    'Staff: ' + name + ' <' + email + '>',
    'Type: ' + type,
    'Dates: ' + _iso(start) + ' \u2192 ' + _iso(end),
    'Duration: ' + dur + ' (' + days + ' day' + (days === 1 ? '' : 's') + ')',
    why ? ('Reason: ' + why) : '',
    String(comment || '').trim() ? ('Manager remark: ' + String(comment).trim()) : '',
    otDate ? ('OT date: ' + _iso(otDate)) : '',
    eventName ? ('Event: ' + eventName) : '',
    '',
    'Created automatically by Firebean Leave App'
  ].filter(function (x) { return x !== ''; }).join('\n');

  let gl = [];
  if (CFG.CALENDAR_GUESTS === 'all') gl = _staffEmails();
  else if (CFG.CALENDAR_GUESTS === 'requester') gl = [email, CFG.MANAGER_EMAIL];
  gl = gl.map(function (e) { return String(e || '').toLowerCase().trim(); })
         .filter(function (e) { return e.indexOf('@') > 0; })
         .filter(function (e, i, a) { return a.indexOf(e) === i; });
  const opts = { description: desc, sendInvites: true };
  if (gl.length) opts.guests = gl.join(',');

  let ev;
  if (half) {
    // 半日 → 用有時段嘅 event，同人手輸入嘅 9am / 2pm 一樣
    const a = new Date(start.getTime()); a.setHours(am ? 9 : 14, 0, 0, 0);
    const b = new Date(start.getTime()); b.setHours(am ? 13 : 18, 0, 0, 0);
    ev = cal.createEvent(title, a, b, opts);
  } else {
    const endExclusive = new Date(end.getTime());
    endExclusive.setDate(endExclusive.getDate() + 1);   // Google all-day 嘅 end 係 exclusive
    ev = cal.createAllDayEvent(title, start, endExclusive, opts);
  }
  Logger.log('Calendar event created on "' + calName + '": ' + title + ' \u2192 ' + ev.getId());
  return ev.getId();
}

// 呢一輪請求發生過啫問題（email 失敗 / DRY_RUN / 日曆失敗）都會收集喺度，直接顯示喺 App 畫面
const _WARN = [];
function _warn(m) { _WARN.push(String(m)); Logger.log('\u26a0\ufe0f ' + m); }
function _warnText() { return _WARN.length ? ' \u26a0\ufe0f ' + _WARN.join(' \u00b7 ') : ''; }

function _send(o) {
  if (CFG.DRY_RUN) {
    _warn('DRY_RUN = true — 冇發 email 去 ' + o.to);
    Logger.log('[DRY RUN] email → ' + o.to + ' | ' + o.subject);
    return;
  }
  try {
    MailApp.sendEmail(o);
  } catch (e) {
    _warn('Email 發不到 ' + o.to + '：' + e.message);
  }
}

/**
 * 取消一個請求（待批或已批核）。
 *   同事只可以取消自己 Pending 嘅；已批核嘅只有管理層可以取消。
 *   會刪除對應嘅日曆事件、發 email、重算結餘。
 */
function cancelLeave(requestId, note, who) {
  _WARN.length = 0;
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return { ok: false, error: 'The system is busy. Please try again in a moment.' };
  try {
    const sess = getSession(who);
    if (!sess.ok) return { ok: false, error: 'You are not on the staff list.' };

    const sh = _sheet(T.REQ);
    const values = sh.getDataRange().getValues();
    let rowIdx = -1, rec = null;
    for (let i = 1; i < values.length; i++) {
      if (String(values[i][0]).trim() === String(requestId).trim()) { rowIdx = i + 1; rec = values[i]; break; }
    }
    if (rowIdx < 0) return { ok: false, error: 'Request not found (it may have been deleted).' };

    const status = String(rec[11] || '').trim();
    const owner  = String(rec[1] || '').toLowerCase();
    const me     = String(sess.email || '').toLowerCase();
    const isOwner = owner === me;

    if (status === 'Cancelled') return { ok: false, error: 'This request has already been cancelled.' };
    if (status === 'Rejected')  return { ok: false, error: 'This request was already rejected.' };
    if (!sess.isManager && !isOwner) return { ok: false, error: 'You can only cancel your own requests.' };
    if (status === 'Approved' && !sess.isManager)
      return { ok: false, error: 'Approved leave can only be cancelled by a manager. Please ask Dickson.' };

    const name  = String(rec[2]);
    const type  = String(rec[3]);
    const start = _date(rec[4]);
    const end   = _date(rec[5]);
    const days  = _num(rec[13]);
    const calId = String(rec[14] || '').trim();
    let hadCal = false;

    /* 已過期（或已開始）嘅假不可取消 —— 只可以取消尚未到期嘅假 */
    const todayD = _today();
    if (start && start < todayD) {
      return { ok: false, error:
        'Cannot cancel: this leave has already started or passed (' + _iso(start) +
        '). Only leave that has not started yet can be cancelled. ' +
        'If the record is wrong, please ask Dickson to adjust it manually.' };
    }

    // 刪日曆
    if (calId) {
      try {
        const ev = _calendar().getEventById(calId);
        if (ev) { ev.deleteEvent(); hadCal = true; }
      } catch (e) {
        _warn('日曆事件刪除失敗：' + e.message);
      }
      sh.getRange(rowIdx, 15).setValue('');
    }

    sh.getRange(rowIdx, 12).setValue('Cancelled');
    if (String(note || '').trim()) sh.getRange(rowIdx, 13).setValue(String(note).trim());

    _emailCancel({
      email: owner, name: name, type: type, start: start, end: end,
      days: days, note: String(note || '').trim(),
      wasStatus: status, hadCal: hadCal,
      byMgr: (sess.isManager && !isOwner), isSelf: isOwner
    });

    try { _syncStaffBalance(); } catch (e) { _warn('結餘同步失敗：' + e.message); }

    return { ok: true, message: 'Cancelled', calRemoved: hadCal, note: _warnText() };
  } catch (e) {
    return { ok: false, error: e.message + _warnText() };
  } finally {
    lock.releaseLock();
  }
}

function _emailNewRequest(sess, d) {
  const lines = [
    'Staff: ' + sess.name + ' (' + sess.email + ')',
    'Type: ' + d.type,
    'Dates: ' + _iso(d.start) + ' \u2192 ' + _iso(d.end),
    'Duration: ' + d.dur,
    'Days: ' + d.days,
    d.otDate ? ('OT date: ' + _iso(d.otDate)) : '',
    d.eventName ? ('Event: ' + d.eventName) : '',
    d.reason ? ('Reason: ' + d.reason) : ''
  ].filter(Boolean).join('\n');

  _send({
    to: CFG.MANAGER_EMAIL,
    subject: 'New leave request: ' + sess.name + ' \u2014 ' + d.type + ' (' + d.days + ' days)',
    body: 'A new leave request is waiting for your approval.\n\n' + lines + '\n\nOpen the Firebean Leave App to action it.'
  });

  _send({
    to: sess.email,
    subject: 'Leave request received \u2014 pending approval',
    body: 'Hi ' + sess.name + ',\n\nWe have received your request. It is now with Dickson for approval and you will be notified once it is decided.\n\n' + lines
  });
}

function _emailDecision(d) {
  const lines = [
    'Type: ' + d.type,
    'Dates: ' + _iso(d.start) + ' \u2192 ' + _iso(d.end),
    'Days: ' + d.days,
    d.otDate ? ('OT date: ' + _iso(d.otDate)) : '',
    d.eventName ? ('Event: ' + d.eventName) : '',
    d.comment ? ('Note: ' + d.comment) : ''
  ].filter(Boolean).join('\n');

  if (d.decision === 'Approved') {
    const b = _balanceFor(d.email, _today());
    _send({
      to: d.email,
      subject: 'Leave approved: ' + d.type + ' (' + d.days + ' days)',
      body: 'Hi ' + d.name + ',\n\nYour leave has been approved and added to the team calendar.\n\n' + lines +
            '\n\nAnnual leave: accrued ' + b.accrued +
            (b.accruedTo ? ' (to ' + _monthLabel(b.accruedTo) + ')' : '') +
            ' \u00b7 used ' + b.used + ' \u00b7 left ' + b.available +
            '.\n\n(Firebean Leave App)'
    });
    _send({
      to: CFG.MANAGER_EMAIL,
      subject: 'You approved ' + d.name + ' \u2014 ' + d.type,
      body: 'Approved and added to the calendar.\n\n' + lines
    });
  } else {
    _send({
      to: d.email,
      subject: 'Leave request not approved: ' + d.type,
      body: 'Hi ' + d.name + ',\n\nYour leave request was not approved.\n\n' + lines + '\n\nPlease speak to Dickson if you have any questions.'
    });
  }
}

/* ============================================================
 *  寫返 Staff!Current Annual Leave
 * ============================================================ */

function _emailCancel(d) {
  const lines = [
    'Type: ' + d.type,
    'Period: ' + _iso(d.start) + (d.start && d.end && _iso(d.start) !== _iso(d.end) ? (' \u2192 ' + _iso(d.end)) : ''),
    'Days returned: ' + d.days,
    d.hadCal ? 'Calendar entry: removed' : '',
    d.note ? ('Note: ' + d.note) : ''
  ].filter(Boolean).join('\n');

  const who = d.isSelf ? 'You cancelled your own'
                       : ('Dickson cancelled your');
  _send({
    to: d.email,
    subject: 'Leave cancelled: ' + d.type + ' (' + d.days + ' days)',
    body: 'Hi ' + d.name + ',\n\n' + who + ' ' + d.wasStatus.toLowerCase() +
          ' leave request. The days have gone back into your balance' +
          (d.hadCal ? ' and the entry has been removed from the team calendar' : '') + '.\n\n' +
          lines + '\n\nIf you still need the time off, submit a new request with the updated dates.\n\n(Firebean Leave App)'
  });

  if (!d.isSelf) {
    _send({
      to: CFG.MANAGER_EMAIL,
      subject: 'Cancelled: ' + d.name + ' \u2014 ' + d.type + ' (' + d.days + ' days)',
      body: 'Cancelled a request that was ' + d.wasStatus.toLowerCase() + '.\n\n' + lines
    });
  }
}

function _syncStaffBalance() {
  const sh = _sheet(T.STAFF);
  const v = sh.getDataRange().getValues();
  const today = _today();
  let n = 0;
  for (let i = 1; i < v.length; i++) {
    const email = String(v[i][0] || '').toLowerCase();
    if (!email) continue;
    const b = _balanceFor(email, today);
    sh.getRange(i + 1, 6).setValue(b.available);   // F = Current Annual Leave
    n++;
  }
  return n;
}

