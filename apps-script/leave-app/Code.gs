/**
 * 診斷 —— 一鍵看清楚而家跑締哪個版本、連住哪個 Sheet、會寫入哪個日曆、email 其不其。
 * 出現「收唔到 email」「日曆冇 remarks」就先 Run 呢個。
 */
function diagnose() {
  const out = [];
  const line = function (k, v) { out.push(String(k).padEnd(16) + ': ' + v); };

  line('BUILD', CFG.BUILD);
  line('DRY_RUN', CFG.DRY_RUN + (CFG.DRY_RUN
    ? '   ← ⚠️ 測試模式：冇發 email、冇寫日曆、冇回寫 Calendar ID'
    : '   ✅ 正式運作'));
  line('MANAGER_EMAIL', CFG.MANAGER_EMAIL);
  line('CALENDAR_NAME', CFG.CALENDAR_NAME || '(primary)');
  line('CALENDAR_GUESTS', CFG.CALENDAR_GUESTS);

  let ss = null;
  try { ss = _ss(); line('連住嘅 Sheet', ss.getName()); line('Sheet ID', ss.getId()); }
  catch (e) { line('連住嘅 Sheet', '❌ ' + e.message); }

  out.push('');
  try { line('實際寫入日曆', _calendar().getName()); }
  catch (e) { line('實際寫入日曆', '❌ ' + e.message); }
  try {
    const names = CalendarApp.getAllCalendars().map(function (c) { return c.getName(); });
    line('你所有日曆', names.join(' / '));
  } catch (e) { line('列出日曆', '❌ ' + e.message); }

  out.push('');
  try { line('Email 剩餘配額', MailApp.getRemainingDailyQuota()); }
  catch (e) { line('Email 配額', '❌ ' + e.message); }
  try { line('登入帳號', _whoami()); } catch (e) {}

  out.push('');
  out.push('最近 5 個請求：');
  try {
    _read(T.REQ).rows.slice(-5).forEach(function (x) {
      out.push('  ' + String(x[2]) + ' · ' + String(x[3]) + ' · ' + String(x[4]) +
               '  → ' + String(x[11]) +
               '  | Calendar ID: ' + (String(x[14] || '') ? '✅有' : '❌冇') +
               '  | Remark: ' + (String(x[12] || '') ? '✅有' : '❌冇'));
    });
  } catch (e) { out.push('  ❌ ' + e.message); }

  out.push('');
  out.push('如果 DRY_RUN 係 true，就係「冇 email」嘅原因。改成 false 後要 Deploy → New version。');

  Logger.log(out.join('\n'));
  return out.join('\n');
}

// Web App 真正嘅 /exec 網址（喺 HtmlService sandbox iframe 內 location.href 唔可靠，
// 所以畀前端做「重新揀 Google 帳號」連結時，必須由伺服器提供）
function _appUrl() {
  try { return String(ScriptApp.getService().getUrl() || ''); } catch (e) { return ''; }
}

// ---- 簽名身份（doGet 頂層請求一定有身份；iframe 內部 google.script.run 有時攞唔到）----
function _signKey() {
  const ps = PropertiesService.getScriptProperties();
  let k = ps.getProperty('WHO_SIGN_KEY');
  if (!k) { k = Utilities.getUuid() + Utilities.getUuid(); ps.setProperty('WHO_SIGN_KEY', k); }
  return k;
}
function _sign(email) {
  const key = _signKey();
  return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(
    String(email).toLowerCase().trim() + '|' + _dayKey(), key));
}
function _dayKey() {
  const d = new Date();
  return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
}
// who = { e: email, t: 簽名 }；只接受今日或昨日簽發嘅簽名
// ---- 電郵一次性驗證碼登入（身份完全讀唔到時嘅後路）----
function sendLoginCode(email) {
  try {
    const e = String(email || '').toLowerCase().trim();
    if (!e || e.indexOf('@') < 0) return { ok: false, error: 'Enter your work email.' };
    if (e.slice(-13) !== '@firebean.net') return { ok: false, error: 'Please use your @firebean.net email.' };
    const s = _read(T.STAFF);
    if (!s.rows.filter(function (r) { return String(r[0]).toLowerCase().trim() === e; }).length)
      return { ok: false, error: 'This email is not on the staff list.' };
    const ps = PropertiesService.getScriptProperties();
    const rk = 'RL:' + e, now = Date.now();
    let rl = []; try { rl = JSON.parse(ps.getProperty(rk) || '[]'); } catch (x) { rl = []; }
    rl = rl.filter(function (t) { return now - t < 3600000; });
    if (rl.length >= 3) return { ok: false, error: 'Too many codes requested — try again in an hour.' };
    const code = String(Math.floor(100000 + Math.random() * 900000));
    ps.setProperty('CODE:' + e, JSON.stringify({ c: code, exp: now + 600000, n: 0 }));
    rl.push(now); ps.setProperty(rk, JSON.stringify(rl));
    MailApp.sendEmail(e, 'Firebean Leave App — 登入驗證碼 ' + code,
      '你嘅登入驗證碼：' + code +
      '\n\n10 分鐘內有效。如果你冇要求過，可以唔理呢封電郵。\n\nYour login code: ' + code);
    _diagLog('', _tmpKey(), 'code-sent:' + e);
    return { ok: true, message: 'Code sent to ' + e + ' (valid 10 min)' };
  } catch (x) { return { ok: false, error: String(x.message || x) }; }
}

function verifyLoginCode(email, code) {
  try {
    const e = String(email || '').toLowerCase().trim(), c = String(code || '').trim();
    const ps = PropertiesService.getScriptProperties();
    const raw = ps.getProperty('CODE:' + e);
    if (!raw) return { ok: false, error: 'Request a code first.' };
    const rec = JSON.parse(raw);
    if (Date.now() > rec.exp) return { ok: false, error: 'Code expired — request a new one.' };
    if (rec.n >= 5) return { ok: false, error: 'Too many attempts — request a new code.' };
    if (String(rec.c) !== c) { rec.n++; ps.setProperty('CODE:' + e, JSON.stringify(rec));
      return { ok: false, error: 'Wrong code.' }; }
    ps.deleteProperty('CODE:' + e);
    const key = _tmpKey();
    if (key) _keySave(key, e);
    _diagLog(e, key, 'code-login-ok');
    return { ok: true, message: 'Signed in as ' + e + ' — reloading…' };
  } catch (x) { return { ok: false, error: String(x.message || x) }; }
}

// 記住呢部瀏覽器（key → email），下次照樣認得（管理員亦可喺 Session_Keys 分頁自行加／刪）
function _keySave(key, email) {
  try {
    const ss = _ss();
    let sh = ss.getSheetByName(T.KEYS);
    if (!sh) { sh = ss.insertSheet(T.KEYS); sh.appendRow(['Key', 'Email', 'Note', 'Added']); sh.setFrozenRows(1); }
    const v = sh.getDataRange().getValues();
    for (let i = 1; i < v.length; i++) {
      if (String(v[i][0]).trim() === String(key).trim()) {
        sh.getRange(i + 1, 2).setValue(email);
        sh.getRange(i + 1, 3).setValue('self-service code login');
        sh.getRange(i + 1, 4).setValue(new Date());
        return true;
      }
    }
    sh.appendRow([key, email, 'self-service code login', new Date()]);
    return true;
  } catch (x) { return false; }
}

function _verifyWho(who) {
  try {
    if (!who || !who.e || !who.t) return '';
    const e = String(who.e).toLowerCase().trim();
    if (!e || e.indexOf('@') < 0) return '';
    if (String(_sign(e)) === String(who.t)) return e;
    const y = new Date(Date.now() - 86400000);
    const yk = y.getFullYear() + '-' + (y.getMonth() + 1) + '-' + y.getDate();
    const yt = Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(
      e + '|' + yk, _signKey()));
    if (String(yt) === String(who.t)) return e;
  } catch (x) {}
  return '';
}

// 匿名瀏覽器指紋（Session 讀唔到 email 時，用嚟認返同一個瀏覽器）
function _tmpKey() {
  try { return String(Session.getTemporaryActiveUserKey() || ''); } catch (e) { return ''; }
}

// Session_Keys 分頁：Key | Email | Note | Added → 由管理員加，一經對應即認得該瀏覽器
function _keyEmail(key) {
  if (!key) return '';
  try {
    const ss = _ss();
    const sh = ss.getSheetByName(T.KEYS);
    if (!sh) return '';
    const v = sh.getDataRange().getValues();
    const short = String(key).slice(0, 8);
    for (let i = 1; i < v.length; i++) {
      const cell = String(v[i][0]).trim();
      // 可以填完整 key，或者畫面上顯示嘅 8 字支援代號
      if (cell && (cell === key || cell === short)) return String(v[i][1]).trim().toLowerCase();
    }
  } catch (e) {}
  return '';
}

// 讀唔到身份時留底（無同事資料），同一瀏覽器 5 分鐘內唔重覆寫
function _diagLog(activeUser, key, err) {
  try {
    const ss = _ss();
    let sh = ss.getSheetByName(T.DIAG);
    if (!sh) {
      sh = ss.insertSheet(T.DIAG);
      sh.appendRow(['Time', 'ActiveUser', 'Key', 'EffectiveUser', 'UA', 'Error']);
      sh.setFrozenRows(1);
    }
    const last = sh.getLastRow();
    if (last > 1) {
      const pv = sh.getRange(last, 1, 1, 3).getValues()[0];
      const ago = (Date.now() - new Date(pv[0]).getTime()) / 1000;
      if (String(pv[2]).trim() === key && String(pv[5] || '').trim() === String(err || '').trim() && ago >= 0 && ago < 300) return 'skip';
    }
    sh.appendRow([new Date(), activeUser || '', key || '', _effEmail(), '', err || '']);
    return 'ok';
  } catch (e) { return 'err: ' + e.message; }
}
function _rememberKey(key, email) {
  // 一讀到 Google 身份（頂層請求或 OTP 登入），就自動記住呢部瀏覽器，
  // 之後就算 iframe 讀唔到 email，都認得返係邊個。
  try {
    if (!key || !email) return 'skip';
    if (_keyEmail(key)) return 'has';
    const ss = _ss();
    let sh = ss.getSheetByName(T.KEYS);
    if (!sh) { sh = ss.insertSheet(T.KEYS); sh.appendRow(['Key', 'Email', 'Note', 'Added']); sh.setFrozenRows(1); }
    sh.appendRow([String(key), String(email).toLowerCase().trim(), 'auto', new Date()]);
    return 'added';
  } catch (e) { return 'err:' + e.message; }
}

function _effEmail() {
  try { return String(Session.getEffectiveUser().getEmail() || ''); } catch (e) { return ''; }
}

/* 任何後台函數出事，都要以「可讀嘅錯誤」回傳，而唔係拋出空白錯誤頁。 */
function _safe(label, fn) {
  try { return fn(); }
  catch (x) {
    const m = (x && x.message) ? x.message : String(x);
    try { _diagLog(_activeEmail(), _tmpKey(), label + ' EXC ' + m); } catch (y) {}
    return { ok: false, reason: 'ERR', email: '', appUrl: _appUrl(), srvWho: '',
             ref: '', dbg: label + ' EXC ' + m + ' @' + CFG.BUILD };
  }
}

function getSession(who) {
  try {
  const email = _activeEmail();
  const key = _tmpKey();
  const v = _verifyWho(who);
  // 身份優先次序：Google 頂層身份 → 已記住嘅瀏覽器 key → 簽名 token（由頂層 doGet 帶落嚟）
  const id = email || _keyEmail(key) || v;
  if (email && key) _rememberKey(key, email);
  const s = _read(T.STAFF);
  const row = s.rows.filter(r => String(r[0]).toLowerCase().trim() === id.toLowerCase().trim())[0];
  if (!row) {
    _diagLog(email, key, 'denied who=' + (who ? (typeof who) : 'none') + ' ver=' + (v || '-') +
             ' key=' + String(key || '').length + ' srv=' + CFG.BUILD);
    return { ok: false, reason: 'NOT_STAFF', email: id, appUrl: _appUrl(), srvWho: email,
             ref: key ? String(key).slice(0, 8) : '', viaKey: !!(!email && id),
             dbg: 'who=' + (who ? (typeof who) : 'none') + ' ver=' + (v || '-') +
                  ' key=' + String(key || '').length + ' srv=' + CFG.BUILD };
  }
  const role = String(row[2] || 'Staff');
  if (!CFG.DRY_RUN) _diagLog(email, key, 'ok via=' + (email ? 'active' : (v ? 'signed' : 'key')));
  return {
    ok: true,
    email: id,
    name: String(row[1] || ''),
    role: role,
    isManager: ['admin', 'manager'].indexOf(role.toLowerCase()) >= 0,
    avatar: _avatarUrl(row[4]),
    today: _iso(new Date()),
    year: new Date().getFullYear(),
    build: CFG.BUILD,
    dryRun: !!CFG.DRY_RUN,
    sheetName: (function () {
      try { return _ss().getName(); } catch (e) { return '讀不到 Sheet'; }
    })(),
    calName: CFG.CALENDAR_NAME || 'primary',
    appUrl: _appUrl()
  };
  } catch (x) {
    try { _diagLog(_activeEmail(), _tmpKey(), 'EXC ' + (x && x.message)); } catch (y) {}
    return { ok: false, reason: 'ERR', email: '', appUrl: _appUrl(), srvWho: '',
             ref: '', dbg: 'EXC ' + (x && x.message) + ' @' + CFG.BUILD };
  }
}

/* ============================================================
 *  員工相片（Staff_Images 資料夾 → lh3 直連，GIF 會保留動畫）
 * ============================================================ */
function _imageIds_() {
  const cache = CacheService.getScriptCache();
  const hit = cache.get('staffImgs');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  const map = {};
  try {
    const it = DriveApp.getFolderById(CFG.STAFF_IMAGES_FOLDER_ID).getFiles();
    while (it.hasNext()) {
      const f = it.next();
      map[f.getName()] = f.getId();
      map[f.getName().toLowerCase()] = f.getId();
    }
  } catch (e) {
    return map;
  }
  try { cache.put('staffImgs', JSON.stringify(map), 21600); } catch (e) {}
  return map;
}

/**
 * 由各種 Google 連結抽出檔案 ID；唔係 Google 連結就回 ''
 * 支援：/file/d/<ID>/view、/d/<ID>、?id=<ID>、lh3.googleusercontent.com/d/<ID>
 */
function _driveIdFromUrl(u) {
  const s = String(u || '');
  if (!/(googleusercontent\.com|drive\.google\.com|docs\.google\.com)/i.test(s)) return '';
  const m = s.match(/\/(?:file\/)?d\/([A-Za-z0-9_-]{10,})/)
         || s.match(/[?&]id=([A-Za-z0-9_-]{10,})/);
  return m ? m[1] : '';
}

/**
 * Staff!E 可能係 "Staff_Images/Francesai.gif" 或純檔名
 * → 回傳可直接 <img src> 嘅網址
 * preferStill = true 時優先用同名 .jpeg/.jpg（名單用小圖，避免載入幾 MB 嘅 GIF）
 */
function _avatarUrl(cell, preferStill) {
  const raw = String(cell || '').trim();
  if (!raw) return '';
  if (/^https?:\/\//i.test(raw)) {
    // Google 相關連結 → 抽出檔案 ID，改寫成可以直接 <img src> 嘅網址
    // （Drive 檢視頁 /file/d/ID/view 係 text/html，<img> 攞唔到圖，會靜靜死圖）
    const id = _driveIdFromUrl(raw);
    if (id) return 'https://lh3.googleusercontent.com/d/' + id;
    return raw;                                       // 其他網址照用
  }
  const name = raw.split('/').pop();
  if (!name) return '';
  const map = _imageIds_();

  if (preferStill) {
    const stem = name.replace(/\.[^.]+$/, '');
    const tries = [stem + '.jpeg', stem + '.jpg', stem + '.png'];
    for (let i = 0; i < tries.length; i++) {
      const sid = map[tries[i]] || map[tries[i].toLowerCase()];
      if (sid) return 'https://lh3.googleusercontent.com/d/' + sid;
    }
  }
  const id = map[name] || map[name.toLowerCase()];
  if (!id) return '';
  return 'https://lh3.googleusercontent.com/d/' + id;
}

