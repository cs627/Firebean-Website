function doGet(e) {
  // ?diag=1 → 只回傳「你係邊個」嘅技術狀態（唔含任何同事資料），
  // 用嚟診斷「Not on the staff list」係身份讀唔到、定係唔喺名單。
  try {
    if (e && e.parameter && String(e.parameter.diag) === '1') {
      let act = '', eff = '', tmpKey = '', err = '';
      try { act = String(Session.getActiveUser().getEmail() || ''); } catch (x) { err += 'active:' + x.message + ' '; }
      try { eff = String(Session.getEffectiveUser().getEmail() || ''); } catch (x) { err += 'eff:' + x.message + ' '; }
      try { tmpKey = String(Session.getTemporaryActiveUserKey() || '').slice(0, 12); } catch (x) {}
      let rows = -1, shName = '';
      try { const r = _read(T.STAFF); rows = r.rows.length; shName = _ss().getName(); } catch (x) { err += 'sheet:' + x.message + ' '; }
      const match = rows > 0 && act ? _read(T.STAFF).rows.filter(r => String(r[0]).toLowerCase().trim() === act.toLowerCase().trim()).length : 0;
      let diagWrite = '';
      if (String(e.parameter.log) === '1') { diagWrite = _diagLog(act, tmpKey, 'selftest'); }
      let codeTest = null;
      if (e.parameter.sendcode) { codeTest = sendLoginCode(e.parameter.sendcode); }
      if (e.parameter.verifycode) { codeTest = verifyLoginCode(e.parameter.verifycode, e.parameter.code || ''); }
      let dash = null;
      if (e.parameter.dash) {
        try {
          const t0 = Date.now();
          const dd = _impl_getDashboard(null);
          const js = JSON.stringify(dd);
          dash = { ok: !!(dd && dd.ok), kb: Math.round(js.length / 1024 / 10.24) / 100, bytes: js.length,
                   ms: Date.now() - t0, topKeys: Object.keys(dd || {}),
                   counts: { requests: ((dd && dd.requests) || []).length,
                             holidays: ((dd && dd.holidays) || []).length,
                             leaveTypes: ((dd && dd.leaveTypes) || []).length,
                             durations: ((dd && dd.durations) || []).length,
                             people: ((dd && dd.people) || []).length,
                             slots: ((dd && dd.slots) || []).length } };
        } catch (x) { dash = { err: String(x && x.message) }; }
      }
      let whoVerified = '';
      if (e.parameter.who) { try { whoVerified = _verifyWho(JSON.parse(e.parameter.who)); } catch (x) { whoVerified = 'parse-err'; } }
      const out = { build: CFG.BUILD, activeUser: act, effectiveUser: eff, tmpKey: tmpKey,
                    staffRows: rows, sheetName: shName, matched: match, diagWrite: diagWrite,
                    whoVerified: whoVerified, dash: dash, codeTest: codeTest, error: err };
      return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
    }
  } catch (x) {}
  let html = Utilities.newBlob(Utilities.base64Decode(HTML_B64)).getDataAsString('UTF-8');
  // 頂層請求（cookie 一定帶到）讀到嘅身份 → 簽名後交畀前端，之後每個呼叫都帶返嚟，
  // 咁就唔怕 iframe 內部（第三方 cookie 被 block 時）讀唔到身份。
  // 前端 JS 出事（sandbox 未 ready、例外）時會 beacon 返嚟，等我睇得到真正原因
  try { if (e && e.parameter && e.parameter.beacon) _diagLog('', _tmpKey(), 'client:' + String(e.parameter.beacon).slice(0, 280)); } catch (x) {}
  try {
    const srvWho = _activeEmail();
    if (srvWho) _rememberKey(_tmpKey(), srvWho);   // 頂層請求一讀到身份，即記住呢部機
    // 伺服器直接預算儀表板資料，內嵌落 HTML。
    // 原因：google.script.run 喺部分瀏覽器／大 payload 情況下回程會靜靜失敗，
    // 前端就會卡死（實測：sess-ok 之後 dash denied + stuck-no-render）。
    // 內嵌之後，第一次畫面完全唔需要任何往返。
    let bootJson = 'null';
    try {
      const b = _impl_getDashboard(srvWho ? { e: srvWho, t: _sign(srvWho) } : null);
      bootJson = JSON.stringify(b)
        .replace(/</g, '\\u003c')
        .replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
      if (!b || !b.ok) {
        try { _diagLog(_activeEmail(), _tmpKey(), 'boot-notok ' + ((b && b.reason) || '') +
                        ' ' + ((b && b.dbg) || '') + ' bytes=' + bootJson.length); } catch (y) {}
      }
    } catch (x) {
      try { _diagLog(_activeEmail(), _tmpKey(), 'boot EXC ' + (x && x.message)); } catch (y) {}
      bootJson = JSON.stringify({ ok: false, reason: 'ERR', dbg: 'boot EXC ' + (x && x.message) });
    }
    const inj = '<script>window.__BUILD=' + JSON.stringify(CFG.BUILD) +
                ';window.__EXEC=' + JSON.stringify(_appUrl()) +
                ';window.__SRVWHO=' + JSON.stringify(srvWho) + ';window.__WHO=' +
                JSON.stringify(srvWho ? { e: srvWho, t: _sign(srvWho) } : null) +
                ';window.__BOOT=' + bootJson + ';</script>';
    if (html.indexOf('</head>') > 0) html = html.replace('</head>', inj + '</head>');
    html = html.replace('</title>', ' · ' + CFG.BUILD + '</title>');
    // 唔畀瀏覽器留住舊版（換 build 之後一定攞到新頁）
    html = html.replace('<head>', '<head>\n<meta http-equiv="Cache-Control" content="no-store, must-revalidate">\n<meta http-equiv="Pragma" content="no-cache">');
  } catch (x) {}
  return HtmlService.createHtmlOutput(html)
    .setTitle('Firebean Leave App')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover');
}

